# Copy this file to .env.local and fill in your real values.
# Get this from https://dashboard.stripe.com/apikeys (use the "Test mode"
# key while developing — it starts with sk_test_).

STRIPE_SECRET_KEY=sk_test_...

# From https://dashboard.stripe.com/webhooks (or `stripe listen` locally).
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin dashboard (/admin) — pick your own password; generate the secret
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Used in robots.txt/sitemap.xml. Set this to your real domain once deployed.
NEXT_PUBLIC_SITE_URL=https://auroracafe.com
