# Copy this file to .env.local and fill in your real values.
# Get this from https://dashboard.stripe.com/apikeys (use the "Test mode"
# key while developing — it starts with sk_test_).

STRIPE_SECRET_KEY=sk_test_...

# From https://dashboard.stripe.com/webhooks (or `stripe listen` locally).
STRIPE_WEBHOOK_SECRET=whsec_...
